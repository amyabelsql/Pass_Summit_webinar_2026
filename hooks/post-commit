#!/usr/bin/env bash
#
# post-commit hook: prints a confirmation message after a commit succeeds,
# summarizing the commit hash, author, and subject line.
#
# Enabled via the same hooks path as pre-commit:
#   git config core.hooksPath hooks

set -euo pipefail

hash=$(git rev-parse --short HEAD)
subject=$(git log -1 --pretty=%s)
author=$(git log -1 --pretty=%an)
branch=$(git rev-parse --abbrev-ref HEAD)

echo ""
echo "✔ Commit successful on branch '$branch'"
echo "  $hash - $subject ($author)"
